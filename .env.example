# Required application configuration. Keep real values in your deployment secret store.
DATABASE_URL="postgresql://nexustrace:replace-with-a-strong-password@postgres:5432/nexustrace?schema=public"
APP_ORIGIN="https://nexustrace.example.gov"
EVIDENCE_STORAGE_ROOT="/var/lib/nexustrace/evidence"

# Required by docker-compose.yml; never use this placeholder in a real deployment.
POSTGRES_USER="nexustrace"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="nexustrace"
# Host ports are for local CLI verification only; containers communicate over
# the private Compose network.
POSTGRES_PORT="54329"

# Optional, safe deployment metadata returned by /api/health.
APP_VERSION="0.1.0"

# Neo4j is a server-only, rebuildable projection of PostgreSQL relationship
# records. Do not use browser-exposed NEXT_PUBLIC_ variables for these values.
NEO4J_URI="bolt://neo4j:7687"
NEO4J_USERNAME="neo4j"
NEO4J_PASSWORD="replace-with-a-strong-neo4j-password"
NEO4J_DATABASE="neo4j"
NEO4J_BOLT_PORT="7687"
