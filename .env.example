# Required application configuration. Keep real values in your deployment secret store.
DATABASE_URL="postgresql://nexustrace:replace-with-a-strong-password@postgres:5432/nexustrace?schema=public"
APP_ORIGIN="https://nexustrace.example.gov"
EVIDENCE_STORAGE_ROOT="/var/lib/nexustrace/evidence"

# Required by docker-compose.yml; never use this placeholder in a real deployment.
POSTGRES_USER="nexustrace"
POSTGRES_PASSWORD="replace-with-a-strong-password"
POSTGRES_DB="nexustrace"

# Optional, safe deployment metadata returned by /api/health.
APP_VERSION="0.1.0"
