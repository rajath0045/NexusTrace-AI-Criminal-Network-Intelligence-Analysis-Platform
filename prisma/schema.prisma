generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  ADMINISTRATOR
  DEPARTMENT_USER
  INVESTIGATOR
}

enum CaseParticipation {
  SUSPECT
  VICTIM
  WITNESS
  COMPLAINANT
  INVESTIGATOR
}

enum CaseStatus {
  OPEN
  ACTIVE
  SUSPENDED
  CLOSED
  ARCHIVED
}

enum GraphEntityType {
  PERSON
  VEHICLE
  PROPERTY
  PHONE
  DEVICE
  BANK_ACCOUNT
  ORGANIZATION
  LOCATION
  CASE
  INCIDENT
}

enum RelationshipStrength {
  PRIMARY
  SECONDARY
  TERTIARY
}

enum EvidenceConfidence {
  VERIFIED
  PROBABLE
  UNVERIFIED
}

enum VerificationState {
  PENDING
  VERIFIED
  REJECTED
  CHANGES_REQUESTED
}

enum IncidentType {
  CRIME
  SUSPICIOUS_EVENT
  MEETING
  ACCIDENT
  TRANSACTION
  COMMUNICATION
  MOVEMENT
  OTHER
}

enum IncidentStatus {
  OPEN
  ACTIVE
  RESOLVED
  ARCHIVED
}

enum IncidentSubmissionStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  REJECTED
  ACCEPTED
}

enum IncidentVerificationLevel {
  UNVERIFIED
  DEPARTMENT_VERIFIED
  CROSS_VERIFIED
}

enum IncidentParticipation {
  SUSPECT
  ACCUSED
  VICTIM
  WITNESS
  COMPLAINANT
  INVESTIGATOR
  OTHER
}

enum CommunicationType {
  CALL
  MESSAGE
  EMAIL
  DIGITAL_CONTACT
  OTHER
}

enum CommunicationDirection {
  INBOUND
  OUTBOUND
  BIDIRECTIONAL
  UNKNOWN
}

enum FinancialTransactionType {
  TRANSFER
  CASH_DEPOSIT
  CASH_WITHDRAWAL
  PAYMENT
  OTHER
}

enum LocationObservationType {
  RESIDENCE
  PROPERTY
  REGISTERED_ADDRESS
  OBSERVED_PERSON_LOCATION
  VEHICLE_OBSERVATION
  DEVICE_OBSERVATION
  INCIDENT_LOCATION
  EVIDENCE_LOCATION
  OTHER_AUTHORIZED_OBSERVATION
}

enum LocationSourceRecordType {
  CASE
  INCIDENT
  EVIDENCE
  COMMUNICATION
  RELATIONSHIP
}

enum FindingReviewStatus {
  UNREVIEWED
  UNDER_REVIEW
  ACKNOWLEDGED
  NEEDS_MORE_EVIDENCE
  DISMISSED
  ESCALATED
}

enum FindingDispositionReason {
  RELEVANT_TO_CASE
  SUPPORTS_EXISTING_LEAD
  REQUIRES_FOLLOW_UP
  INSUFFICIENT_HISTORY
  WEAK_PROVENANCE
  MISSING_SOURCE_RECORD
  REQUIRES_DEPARTMENT_INPUT
  EXPECTED_BEHAVIOR
  DUPLICATE_FINDING
  DATA_QUALITY_ISSUE
  FALSE_POSITIVE
  NOT_RELEVANT_TO_CASE
  CROSS_CASE_RELEVANCE
  CROSS_DEPARTMENT_RELEVANCE
  REQUIRES_SUPERVISOR_REVIEW
  REQUIRES_ADMIN_CROSS_VERIFICATION
}

enum ReportType {
  INVESTIGATION_REPORT
}

enum ReportStatus {
  GENERATED
}

model Department {
  id            String              @id @default(uuid()) @db.Uuid
  code          String              @unique
  name          String
  users         User[]
  cases         Case[]
  evidence      Evidence[]
  incidents     Incident[]
  graphEntities GraphEntity[]
  relationships GraphRelationship[]
  auditEvents   AuditEvent[]
  communications CommunicationRecord[]
  financialTransactions FinancialTransaction[]
  investigationFindings InvestigationFinding[]
  findingReviews FindingReview[]
  locationObservations EntityLocationObservation[]
  reports        Report[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model User {
  id                    String                @id @default(uuid()) @db.Uuid
  email                 String                @unique
  displayName           String
  passwordHash          String
  role                  UserRole
  active                Boolean               @default(true)
  departmentId          String                @db.Uuid
  department            Department            @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  sessions              Session[]
  investigatedCases     Case[]                @relation("InvestigatingOfficer")
  uploadedEvidence      Evidence[]            @relation("EvidenceUploader")
  createdRelationships  GraphRelationship[]   @relation("RelationshipCreator")
  verifiedRelationships GraphRelationship[]   @relation("RelationshipVerifier")
  auditEvents           AuditEvent[]
  workspaceLayouts      UserWorkspaceLayout[]
  graphProjectionEvents GraphProjectionEvent[] @relation("GraphProjectionEventRequester")
  findingReviews        FindingReview[]          @relation("FindingReviewer")
  submittedIncidents    Incident[]              @relation("IncidentSubmitter")
  departmentVerifiedIncidents Incident[]         @relation("IncidentDepartmentVerifier")
  crossVerifiedIncidents Incident[]              @relation("IncidentCrossVerifier")
  createdLocationObservations EntityLocationObservation[] @relation("LocationObservationCreator")
  reportsCreated            Report[] @relation("ReportCreator")
  reportVersionsGenerated   ReportVersion[] @relation("ReportVersionGenerator")
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([departmentId])
  @@index([role, active])
}

// This is an outbox only.  It is deliberately not a second domain model: the
// payload is a projection request whose source remains the canonical rows.
model GraphProjectionEvent {
  id              String   @id @default(uuid()) @db.Uuid
  aggregateType   String
  aggregateId     String   @db.Uuid
  eventType       String
  requestedById   String?  @db.Uuid
  requestedBy     User?    @relation("GraphProjectionEventRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  attempts        Int      @default(0)
  availableAt     DateTime @default(now())
  processedAt     DateTime?
  lastError       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([processedAt, availableAt])
  @@index([aggregateType, aggregateId])
}

model UserWorkspaceLayout {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @db.Uuid
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceKey String
  version      Int
  layoutJson   Json
  updatedAt    DateTime @updatedAt

  @@unique([userId, workspaceKey])
  @@index([userId])
}

model Session {
  id         String   @id @default(uuid()) @db.Uuid
  tokenHash  String   @unique
  userId     String   @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([expiresAt])
}

model Case {
  id                     String                 @id @default(uuid()) @db.Uuid
  firNumber              String                 @unique
  caseNumber             String                 @unique
  title                  String
  category               String
  occurredAt             DateTime?
  occurrenceLocation     String?
  status                 CaseStatus             @default(OPEN)
  description            String
  departmentId           String                 @db.Uuid
  department             Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  investigatingOfficerId String?                @db.Uuid
  investigatingOfficer   User?                  @relation("InvestigatingOfficer", fields: [investigatingOfficerId], references: [id], onDelete: SetNull)
  people                 CasePerson[]
  evidence               Evidence[]
  graphEntity            GraphEntity?
  relationshipEvidence   RelationshipEvidence[]
  incidents              Incident[]
  communications         CommunicationRecord[]
  financialTransactions  FinancialTransaction[]
  investigationFindings  InvestigationFinding[]
  reports                Report[]
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([departmentId, status])
  @@index([investigatingOfficerId])
}

model Person {
  id           String       @id @default(uuid()) @db.Uuid
  givenName    String
  familyName   String
  aliases      String[]     @default([])
  dateOfBirth  DateTime?
  gender       String?
  nationality  String?
  identityData Json?
  cases        CasePerson[]
  graphEntity  GraphEntity?
  incidents    IncidentParticipant[]
  investigationFindings InvestigationFinding[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([familyName, givenName])
}

model CasePerson {
  id            String            @id @default(uuid()) @db.Uuid
  caseId        String            @db.Uuid
  case          Case              @relation(fields: [caseId], references: [id], onDelete: Cascade)
  personId      String            @db.Uuid
  person        Person            @relation(fields: [personId], references: [id], onDelete: Restrict)
  participation CaseParticipation
  notes         String?
  createdAt     DateTime          @default(now())

  @@unique([caseId, personId, participation])
  @@index([caseId])
  @@index([personId])
}

model Evidence {
  id                   String                 @id @default(uuid()) @db.Uuid
  caseId               String                 @db.Uuid
  case                 Case                   @relation(fields: [caseId], references: [id], onDelete: Restrict)
  uploadedById         String                 @db.Uuid
  uploadedBy           User                   @relation("EvidenceUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  departmentId         String                 @db.Uuid
  department           Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  originalFilename     String
  mediaType            String
  byteSize             Int
  checksumSha256       String
  storageKey           String                 @unique
  description          String?
  verificationState    VerificationState      @default(PENDING)
  relationshipEvidence RelationshipEvidence[]
  incidentEvidence     IncidentEvidence[]
  communicationSources CommunicationRecord[] @relation("CommunicationSourceEvidence")
  financialTransactionSources FinancialTransaction[] @relation("FinancialTransactionSourceEvidence")
  locationObservations EntityLocationObservation[]
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt

  @@index([caseId])
  @@index([departmentId, verificationState])
  @@index([uploadedById])
  @@index([checksumSha256])
}

model GraphEntity {
  id                 String              @id @default(uuid()) @db.Uuid
  entityType         GraphEntityType
  displayLabel       String
  verificationState  VerificationState   @default(PENDING)
  departmentId       String              @db.Uuid
  department         Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  personId           String?             @unique @db.Uuid
  person             Person?             @relation(fields: [personId], references: [id], onDelete: Cascade)
  caseId             String?             @unique @db.Uuid
  case               Case?               @relation(fields: [caseId], references: [id], onDelete: Cascade)
  incidentId         String?             @unique @db.Uuid
  incident           Incident?           @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  incidentParticipants IncidentParticipant[] @relation("IncidentEntityParticipant")
  canonicalReference String?             @unique
  outgoing           GraphRelationship[] @relation("RelationshipSource")
  incoming           GraphRelationship[] @relation("RelationshipTarget")
  sourceCommunications CommunicationRecord[] @relation("CommunicationSource")
  destinationCommunications CommunicationRecord[] @relation("CommunicationDestination")
  sourceTransactions FinancialTransaction[] @relation("FinancialTransactionSource")
  destinationTransactions FinancialTransaction[] @relation("FinancialTransactionDestination")
  locationObservations EntityLocationObservation[]
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  @@index([departmentId, entityType])
  @@index([verificationState])
}

model EntityLocationObservation {
  id                String                    @id @default(uuid()) @db.Uuid
  graphEntityId     String                    @db.Uuid
  graphEntity       GraphEntity               @relation(fields: [graphEntityId], references: [id], onDelete: Cascade)
  latitude          Decimal                   @db.Decimal(9, 6)
  longitude         Decimal                   @db.Decimal(9, 6)
  observedAt        DateTime
  observationType   LocationObservationType
  locationLabel     String
  context           String?
  accuracyMeters    Int?
  sourceRecordType  LocationSourceRecordType
  sourceRecordId    String                    @db.Uuid
  sourceEvidenceId  String?                   @db.Uuid
  sourceEvidence    Evidence?                 @relation(fields: [sourceEvidenceId], references: [id], onDelete: SetNull)
  departmentId      String                    @db.Uuid
  department        Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  verificationLevel IncidentVerificationLevel @default(UNVERIFIED)
  createdById       String                    @db.Uuid
  createdBy         User                      @relation("LocationObservationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt         DateTime                  @default(now())

  @@index([graphEntityId, observedAt])
  @@index([departmentId, observedAt])
  @@index([sourceRecordType, sourceRecordId])
  @@index([observationType, observedAt])
  @@index([sourceEvidenceId])
  @@index([createdById])
}

model Incident {
  id                       String                    @id @default(uuid()) @db.Uuid
  incidentNumber           String                    @unique
  incidentType             IncidentType
  title                    String
  description              String
  occurredAt               DateTime
  location                 String?
  status                   IncidentStatus            @default(OPEN)
  submissionStatus         IncidentSubmissionStatus  @default(PENDING_REVIEW)
  verificationLevel        IncidentVerificationLevel @default(UNVERIFIED)
  departmentId             String                    @db.Uuid
  department               Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  caseId                   String?                   @db.Uuid
  case                     Case?                     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  submittedById            String                    @db.Uuid
  submittedBy              User                      @relation("IncidentSubmitter", fields: [submittedById], references: [id], onDelete: Restrict)
  submittedAt              DateTime                  @default(now())
  departmentVerifiedById   String?                   @db.Uuid
  departmentVerifiedBy     User?                     @relation("IncidentDepartmentVerifier", fields: [departmentVerifiedById], references: [id], onDelete: SetNull)
  departmentVerifiedAt     DateTime?
  crossVerifiedById        String?                   @db.Uuid
  crossVerifiedBy          User?                     @relation("IncidentCrossVerifier", fields: [crossVerifiedById], references: [id], onDelete: SetNull)
  crossVerifiedAt          DateTime?
  reviewReason             String?
  people                   IncidentParticipant[]
  evidence                 IncidentEvidence[]
  graphEntity              GraphEntity?
  communications           CommunicationRecord[]
  financialTransactions    FinancialTransaction[]
  investigationFindings    InvestigationFinding[]
  reports                  Report[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@index([departmentId, occurredAt])
  @@index([caseId, occurredAt])
  @@index([submittedById, submissionStatus])
  @@index([verificationLevel, occurredAt])
}

model IncidentParticipant {
  id            String                @id @default(uuid()) @db.Uuid
  incidentId    String                @db.Uuid
  incident      Incident              @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  personId      String?               @db.Uuid
  person        Person?               @relation(fields: [personId], references: [id], onDelete: Restrict)
  graphEntityId String?               @db.Uuid
  graphEntity   GraphEntity?          @relation("IncidentEntityParticipant", fields: [graphEntityId], references: [id], onDelete: Restrict)
  participation IncidentParticipation
  notes         String?
  createdAt     DateTime              @default(now())

  @@unique([incidentId, personId, participation])
  @@index([personId, createdAt])
  @@index([graphEntityId, createdAt])
  @@index([incidentId])
}

model IncidentEvidence {
  id          String   @id @default(uuid()) @db.Uuid
  incidentId  String   @db.Uuid
  incident    Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  evidenceId  String   @db.Uuid
  evidence    Evidence @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  note        String?
  createdAt   DateTime @default(now())

  @@unique([incidentId, evidenceId])
  @@index([evidenceId])
  @@index([incidentId])
}

model GraphRelationship {
  id                 String                 @id @default(uuid()) @db.Uuid
  sourceEntityId     String                 @db.Uuid
  sourceEntity       GraphEntity            @relation("RelationshipSource", fields: [sourceEntityId], references: [id], onDelete: Restrict)
  targetEntityId     String                 @db.Uuid
  targetEntity       GraphEntity            @relation("RelationshipTarget", fields: [targetEntityId], references: [id], onDelete: Restrict)
  relationshipType   String
  strength           RelationshipStrength
  evidenceConfidence EvidenceConfidence
  verificationState  VerificationState      @default(PENDING)
  interactionCount   Int                    @default(0)
  interactionSummary String?
  startsAt           DateTime?
  endsAt             DateTime?
  departmentId       String                 @db.Uuid
  department         Department             @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  createdById        String                 @db.Uuid
  createdBy          User                   @relation("RelationshipCreator", fields: [createdById], references: [id], onDelete: Restrict)
  verifiedById       String?                @db.Uuid
  verifiedBy         User?                  @relation("RelationshipVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  verifiedAt         DateTime?
  evidence           RelationshipEvidence[]
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  @@unique([sourceEntityId, targetEntityId, relationshipType])
  @@index([sourceEntityId, verificationState, strength])
  @@index([targetEntityId, verificationState, strength])
  @@index([departmentId])
  @@index([createdById])
  @@index([verifiedById])
}

model RelationshipEvidence {
  id             String            @id @default(uuid()) @db.Uuid
  relationshipId String            @db.Uuid
  relationship   GraphRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  evidenceId     String            @db.Uuid
  evidence       Evidence          @relation(fields: [evidenceId], references: [id], onDelete: Restrict)
  sourceCaseId   String            @db.Uuid
  sourceCase     Case              @relation(fields: [sourceCaseId], references: [id], onDelete: Restrict)
  note           String?
  createdAt      DateTime          @default(now())

  @@unique([relationshipId, evidenceId])
  @@index([relationshipId])
  @@index([evidenceId])
  @@index([sourceCaseId])
}

model CommunicationRecord {
  id                    String                    @id @default(uuid()) @db.Uuid
  communicationNumber   String                    @unique
  communicationType     CommunicationType
  occurredAt            DateTime
  sourceEntityId        String                    @db.Uuid
  sourceEntity          GraphEntity               @relation("CommunicationSource", fields: [sourceEntityId], references: [id], onDelete: Restrict)
  destinationEntityId   String                    @db.Uuid
  destinationEntity     GraphEntity               @relation("CommunicationDestination", fields: [destinationEntityId], references: [id], onDelete: Restrict)
  sourceIdentifier      String?
  destinationIdentifier String?
  durationSeconds       Int?
  direction             CommunicationDirection    @default(UNKNOWN)
  caseId                String?                   @db.Uuid
  case                  Case?                     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  incidentId            String?                   @db.Uuid
  incident              Incident?                 @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  sourceEvidenceId      String?                   @db.Uuid
  sourceEvidence        Evidence?                 @relation("CommunicationSourceEvidence", fields: [sourceEvidenceId], references: [id], onDelete: SetNull)
  departmentId          String                    @db.Uuid
  department            Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  verificationLevel     IncidentVerificationLevel @default(UNVERIFIED)
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt

  @@index([departmentId, occurredAt])
  @@index([caseId, occurredAt])
  @@index([incidentId, occurredAt])
  @@index([sourceEntityId, occurredAt])
  @@index([destinationEntityId, occurredAt])
}

model FinancialTransaction {
  id                  String                    @id @default(uuid()) @db.Uuid
  transactionNumber   String                    @unique
  transactionType     FinancialTransactionType
  occurredAt          DateTime
  sourceEntityId      String                    @db.Uuid
  sourceEntity        GraphEntity               @relation("FinancialTransactionSource", fields: [sourceEntityId], references: [id], onDelete: Restrict)
  destinationEntityId String                    @db.Uuid
  destinationEntity   GraphEntity               @relation("FinancialTransactionDestination", fields: [destinationEntityId], references: [id], onDelete: Restrict)
  amount              Decimal                   @db.Decimal(18, 2)
  currency            String                    @default("INR")
  caseId              String?                   @db.Uuid
  case                Case?                     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  incidentId          String?                   @db.Uuid
  incident            Incident?                 @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  sourceEvidenceId    String?                   @db.Uuid
  sourceEvidence      Evidence?                 @relation("FinancialTransactionSourceEvidence", fields: [sourceEvidenceId], references: [id], onDelete: SetNull)
  departmentId        String                    @db.Uuid
  department          Department                @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  verificationLevel   IncidentVerificationLevel @default(UNVERIFIED)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  @@index([departmentId, occurredAt])
  @@index([caseId, occurredAt])
  @@index([incidentId, occurredAt])
  @@index([sourceEntityId, occurredAt])
  @@index([destinationEntityId, occurredAt])
}

model InvestigationFinding {
  id                   String              @id @default(uuid()) @db.Uuid
  findingKey           String              @unique
  category             String
  title                String
  detail               String
  personId             String              @db.Uuid
  person               Person              @relation(fields: [personId], references: [id], onDelete: Restrict)
  incidentId           String              @db.Uuid
  incident             Incident            @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  caseId               String?             @db.Uuid
  case                 Case?               @relation(fields: [caseId], references: [id], onDelete: SetNull)
  departmentId         String              @db.Uuid
  department           Department          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  windowStart          DateTime
  windowEnd            DateTime
  generatedAt          DateTime            @default(now())
  supportingRecordIds  Json
  evidenceIds          Json
  verificationLevels   Json
  analysisSnapshot     Json?
  reviewStatus         FindingReviewStatus @default(UNREVIEWED)
  reviews              FindingReview[]
  updatedAt            DateTime            @updatedAt

  @@index([departmentId, reviewStatus, generatedAt])
  @@index([personId, generatedAt])
  @@index([incidentId, generatedAt])
  @@index([caseId, generatedAt])
}

model FindingReview {
  id                   String                   @id @default(uuid()) @db.Uuid
  findingId            String                   @db.Uuid
  finding              InvestigationFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  reviewerUserId       String                   @db.Uuid
  reviewer             User                     @relation("FindingReviewer", fields: [reviewerUserId], references: [id], onDelete: Restrict)
  reviewerDepartmentId String                   @db.Uuid
  reviewerDepartment   Department               @relation(fields: [reviewerDepartmentId], references: [id], onDelete: Restrict)
  previousStatus       FindingReviewStatus
  status               FindingReviewStatus
  reasonCode           FindingDispositionReason
  note                 String?
  createdAt            DateTime                 @default(now())

  @@index([findingId, createdAt])
  @@index([reviewerUserId, createdAt])
  @@index([reviewerDepartmentId, createdAt])
}

model AuditEvent {
  id           String      @id @default(uuid()) @db.Uuid
  actorId      String?     @db.Uuid
  actor        User?       @relation(fields: [actorId], references: [id], onDelete: SetNull)
  departmentId String?     @db.Uuid
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)
  action       String
  targetType   String
  targetId     String?
  outcome      String
  metadata     Json?
  createdAt    DateTime    @default(now())

  @@index([actorId, createdAt])
  @@index([departmentId, createdAt])
  @@index([action, createdAt])
}

model Report {
  id           String     @id @default(uuid()) @db.Uuid
  reportNumber String     @unique
  title        String
  reportType   ReportType @default(INVESTIGATION_REPORT)
  departmentId String     @db.Uuid
  department   Department @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  caseId       String     @db.Uuid
  case         Case       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  incidentId   String?    @db.Uuid
  incident     Incident?  @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  createdById  String     @db.Uuid
  createdBy    User       @relation("ReportCreator", fields: [createdById], references: [id], onDelete: Restrict)
  createdAt    DateTime   @default(now())
  versions     ReportVersion[]

  @@index([departmentId, createdAt])
  @@index([caseId, createdAt])
  @@index([incidentId, createdAt])
}

model ReportVersion {
  id            String       @id @default(uuid()) @db.Uuid
  reportId      String       @db.Uuid
  report        Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  version       Int
  status        ReportStatus @default(GENERATED)
  snapshot      Json
  timelineStart DateTime?
  timelineEnd   DateTime?
  generatedById String       @db.Uuid
  generatedBy   User         @relation("ReportVersionGenerator", fields: [generatedById], references: [id], onDelete: Restrict)
  generatedAt   DateTime     @default(now())
  sources       ReportSourceReference[]

  @@unique([reportId, version])
  @@index([reportId, generatedAt])
}

model ReportSourceReference {
  id                String        @id @default(uuid()) @db.Uuid
  reportVersionId   String        @db.Uuid
  reportVersion     ReportVersion @relation(fields: [reportVersionId], references: [id], onDelete: Cascade)
  sourceType        String
  sourceId          String
  caseId            String?       @db.Uuid
  incidentId        String?       @db.Uuid
  evidenceId        String?       @db.Uuid
  actorId           String?       @db.Uuid
  observedAt        DateTime?
  verificationState String?
  reviewState       String?
  metadata          Json?

  @@unique([reportVersionId, sourceType, sourceId])
  @@index([reportVersionId, sourceType])
}
